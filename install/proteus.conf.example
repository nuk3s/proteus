# proteus.conf — installer configuration.
# Copy this file to install/proteus.conf and edit before running install.sh.

# Management NIC — the interface SSH/admin traffic arrives on (e.g. ens18).
MGMT_IFACE=ens18

# Client NIC — the interface facing the client VLAN this box gateways for
# (e.g. ens19). Must be a distinct NIC from MGMT_IFACE (gateway mode requires
# two NICs; single-NIC SOCKS mode is a future spec, not this installer).
CLIENT_IFACE=ens19

# CIDR of the management LAN (SSH/admin access is only accepted from here).
MGMT_CIDR=10.0.0.0/24

# CIDR of the client VLAN this box is the default gateway for.
CLIENT_VLAN_CIDR=172.16.1.0/24

# This box's IP on the client VLAN (also unbound's client-facing DNS listener).
# Must lie inside CLIENT_VLAN_CIDR.
CLIENT_GW_IP=172.16.1.5

# Number of rotating Proton WireGuard slots (client egress tunnels). 1-9
# (capped at 9: a 2-digit index overflows the 15-char veth name limit during
# staged rotation, e.g. v-proton-10-s-ns is 16 chars).
SLOT_COUNT=5

# Space-separated resolvers written to the per-netns resolv.conf of each
# rotating slot. Used by the reputation probes and anything else run with
# `ip netns exec` — NOT by the gateway resolver clients talk to (see
# UNBOUND_UPSTREAM below). Keep these unfiltered: point the probe namespaces at
# an ad blocklist and a domain on your custom check list makes every exit look
# broken, which wedges rotation.
DNS_UPSTREAMS="9.9.9.9 9.9.9.10 149.112.112.10"

# The single upstream unbound forwards "." to — the resolver every client on
# the VLAN ends up using, since their port-53 traffic is redirected to unbound.
# Default 10.2.0.1 is the gateway address inside every Proton WireGuard tunnel,
# i.e. Proton's in-tunnel NetShield resolver: it filters ads/trackers/malware at
# the level baked into your tunnel certificates, it is reached over the
# dedicated DNS tunnel (~12ms), and it never needs changing when that tunnel
# rotates to a different exit.
#
# Consequence worth knowing: with an in-tunnel resolver the installer renders
# unbound WITHOUT DNSSEC validation, because NetShield NXDOMAINs the DS query
# for a blocked name too and a validating resolver would turn every blocked ad
# domain into a SERVFAIL instead of a clean NXDOMAIN. 10.2.0.1 validates
# upstream itself and the last hop is inside WireGuard. Set this to a public
# resolver (e.g. 9.9.9.9) and the installer puts both the validator and
# DNS-over-TLS back automatically — but then clients get no NetShield.
UNBOUND_UPSTREAM=10.2.0.1

# Proton country code used when minting new WireGuard configs.
PROTON_COUNTRY=US

# Minimum acceptable throughput (Mbps) for a slot to be considered healthy
# by the streaming-bandwidth probe.
STREAMING_MIN_MBPS=25

# Seconds before the apply-phase nftables auto-revert fires if you never
# run `install.sh --confirm`. This is the SSH-lockout safety net.
NFT_REVERT_SECONDS=900

# TCP port the web UI (proteus-ui) listens on, HTTPS only. Reachable from
# MGMT_CIDR and CLIENT_VLAN_CIDR (see nftables rules).
UI_PORT=8443

# One extra source CIDR allowed to reach the web UI on the mgmt interface, on
# top of MGMT_CIDR. Use this for an admin/workstation subnet that isn't the
# proxy's own mgmt network. Default 127.0.0.1/32 means "no extra source".
UI_MGMT_EXTRA=127.0.0.1/32

# Should devices on the CLIENT VLAN be able to reach the web UI?
# The panel has no source-based authorisation: anyone who reaches it and has
# the passphrase gets the same full-privilege UI as you do from the management
# LAN — rotate exits, write knobs, drive the privileged broker. On a VLAN whose
# whole purpose is to carry untrusted devices, that is usually not what you
# want, so this defaults to "no" and the UI is reachable from MGMT_CIDR (plus
# UI_MGMT_EXTRA) only.
# Set to "yes" only if you administer the gateway from a device on the client
# VLAN itself.
UI_CLIENT_VLAN_ACCESS=no
