# Rendered by the installer from proteus.conf. Sourced by /etc/proteus/bin/*.
PROTEUS_CLIENT_VLAN_CIDR=${CLIENT_VLAN_CIDR}
PROTEUS_CLIENT_GW_IP=${CLIENT_GW_IP}
# The client-VLAN interface. routeguard.sh keys its ingress sink on it (with
# no value it falls back to the interface holding PROTEUS_CLIENT_GW_IP).
PROTEUS_CLIENT_IFACE=${CLIENT_IFACE}
PROTEUS_MGMT_CIDR=${MGMT_CIDR}
PROTEUS_DNS_UPSTREAMS="${DNS_UPSTREAMS}"
PROTEUS_STREAMING_MIN_MBPS=${STREAMING_MIN_MBPS}
PROTEUS_PROTON_COUNTRY=${PROTON_COUNTRY}
PROTEUS_DNS_INSTANCE=${DNS_INSTANCE}
PROTEUS_DNS_INDEX=${DNS_INDEX}
PROTEUS_UI_PORT=${UI_PORT}
# The resolver the UDM tunnel hands to trusted-VLAN hosts. Site-specific, so it
# ships empty: it must be YOUR LAN resolver (the ad-blocking one those hosts
# already use), never a public or in-tunnel one, or they lose ad-blocking and
# internal names the moment their egress moves. Set it in the web UI under
# Settings > UDM tunnel (trusted-VLAN egress); pairing refuses to run while it
# is empty, because UniFi will not save a VPN Client with no DNS line.
PROTEUS_UDM_DNS=
