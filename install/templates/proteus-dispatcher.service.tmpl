[Unit]
Description=Proteus NFQUEUE dispatcher
After=network-online.target nftables.service
Wants=network-online.target
# Requires at least one VPN namespace to be up - but we rely on script to exit 1 if none
ConditionPathIsDirectory=/etc/proteus/state

[Service]
Type=simple
EnvironmentFile=/etc/proteus/proteus.env
EnvironmentFile=-/etc/proteus/proteus-local.env
# Arm fail-closed routing (catch rule + ingress sink, see routeguard.sh)
# before the first mark is handed out: a slot unit that failed early may never
# have reached its own routeguard call, and ip rules do not survive a reboot.
# `+` runs it outside this unit's sandbox; `-` keeps a failure from taking the
# dispatcher (and so all client egress) down: it is logged, and the firewall
# still holds.
ExecStartPre=-+/etc/proteus/bin/routeguard.sh
ExecStart=/etc/proteus/bin/dispatcher.py
Restart=on-failure
# A SIGHUP that lands before dispatcher.py has installed its handler (while
# it imports and starts up) or during interpreter shutdown kills the
# process, and systemd counts death by SIGHUP as a clean exit, so
# Restart=on-failure alone would leave it down. rotate-slot.sh sends one
# after every promotion.
RestartForceExitStatus=SIGHUP
RestartSec=5s
User=root
# Hardening
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/log/proteus /run/proteus
# /run/proteus is provisioned by tmpfiles.d (root:proteus-ui 0750) so the UI group can read the snapshot
# NFQUEUE needs CAP_NET_ADMIN; shelling out to nft needs root
AmbientCapabilities=CAP_NET_ADMIN
CapabilityBoundingSet=CAP_NET_ADMIN CAP_DAC_READ_SEARCH CAP_DAC_OVERRIDE
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictNamespaces=yes
RestrictRealtime=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
