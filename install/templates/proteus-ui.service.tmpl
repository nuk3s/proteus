[Unit]
Description=Proteus web UI
After=network-online.target proteus-ui-apply.socket
Wants=proteus-ui-apply.socket

[Service]
Type=simple
User=proteus-ui
Group=proteus-ui
EnvironmentFile=/etc/proteus/proteus.env
EnvironmentFile=-/etc/proteus/proteus-local.env
ExecStart=/usr/bin/python3 /etc/proteus/bin/proteus-ui
Restart=on-failure
RestartSec=2
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/etc/proteus/ui/secrets
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
MemoryDenyWriteExecute=yes
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
