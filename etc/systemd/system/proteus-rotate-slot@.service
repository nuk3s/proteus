[Unit]
Description=Rotate proteus slot %i to a fresh Proton WG config
After=network-online.target proteus-dispatcher.service
Wants=network-online.target
Requires=proteus-dispatcher.service

[Service]
Type=oneshot
ExecStart=/etc/proteus/bin/rotate-slot.sh %i
# The script stops itself at ROTATION_DEADLINE_S (25 min) plus at most one in-flight attempt; this is the backstop.
TimeoutStartSec=45min
Nice=10
