[Unit]
Description=Bring up the dedicated DNS WireGuard tunnel (dns-6)
After=network-online.target nftables.service
Wants=network-online.target
Before=unbound.service proteus-dispatcher.service

[Service]
Type=oneshot
ExecStart=/etc/proteus/bin/vpnns-up.sh dns-6 /etc/proteus/wg/proton/auto/dns-6.conf
RemainAfterExit=yes
ExecStop=/etc/proteus/bin/vpnns-down.sh dns-6

[Install]
WantedBy=multi-user.target
