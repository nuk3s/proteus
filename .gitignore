# Runtime / secrets — never commit
# WG configs contain private keys
etc/proteus/wg/
# Per-tunnel state (peer pubkeys, endpoints)
etc/proteus/state/
# Proton SSO refresh token
etc/Proton/

# Brainstorm session artifacts (visual companion)
.superpowers/

# Backups / editor noise
*.bak
*.bak-*
*~
__pycache__/
*.pyc
install/proteus.conf
install/.staging/

# Runtime custom health-check list (operator URLs)
etc/proteus/checks.json
